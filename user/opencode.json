{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "deny",
      "python .opencode/script/run_cmd.py*": "allow",
      "python3 .opencode/script/run_cmd.py*": "allow"
    },
    "external_directory": {
      "~/.config/opencode/**": "allow"
    },
    "edit": {
      "*": "allow",
      "**/dev.md": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa": "deny",
      "id_rsa.*": "deny",
      "id_ed25519": "deny",
      "id_ed25519.*": "deny",
      ".npmrc": "deny",
      ".netrc": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      "*.keystore": "deny",
      "credentials": "deny",
      "credentials.json": "deny"
    }
  }
}
